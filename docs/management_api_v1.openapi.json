            "title": "Manifest Path"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "postgres_schema": {
            "title": "Postgres Schema",
            "type": "string"
          },
          "runtime_checked": {
            "title": "Runtime Checked",
            "type": "boolean"
          },
          "runtime_dir": {
            "title": "Runtime Dir",
            "type": "string"
          },
          "vault_dir": {
            "title": "Vault Dir",
            "type": "string"
          },
          "workspace_root": {
            "anyOf": [
              {
                "type": "string"
              },
