{
  "components": {
    "schemas": {
      "CreateProjectRequest": {
        "additionalProperties": false,
        "description": "Only identity, display name and installed Domain are client-controlled.",
        "properties": {
          "domain": {
            "title": "Domain",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "domain"
        ],
        "title": "CreateProjectRequest",
        "type": "object"
      },
      "DomainList": {
        "description": "Installed Domain summaries, including invalid packs.",
        "properties": {
          "domains": {
            "items": {
              "$ref": "#/components/schemas/DomainView"
            },
            "title": "Domains",
            "type": "array"
          },
          "runtime_checked": {
            "title": "Runtime Checked",
            "type": "boolean"
          }
        },
        "required": [
          "domains",
          "runtime_checked"
        ],
        "title": "DomainList",
        "type": "object"
      },
      "DomainView": {
        "description": "Installed Domain pack inspection, without readiness claims.",
        "properties": {
          "configuration_valid": {
            "title": "Configuration Valid",
            "type": "boolean"
          },
          "diagnostic": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Diagnostic"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "tagline": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tagline"
          }
        },
        "required": [
          "id",
          "tagline",
          "configuration_valid"
        ],
        "title": "DomainView",
        "type": "object"
      },
