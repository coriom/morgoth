          "id",
          "name",
          "domain",
          "legacy",
          "manifest_path",
          "workspace_root",
          "postgres_schema",
          "chroma_prefix",
          "vault_dir",
          "runtime_dir",
          "configuration_valid",
          "runtime_checked"
