        "description": "Published local configuration result, including durability status.",
        "properties": {
          "created": {
            "title": "Created",
            "type": "boolean"
          },
          "durability_confirmed": {
            "title": "Durability Confirmed",
            "type": "boolean"
          },
          "engine_started": {
            "title": "Engine Started",
            "type": "boolean"
          },
