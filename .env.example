# Morgoth environment — copy to .env and fill in values. NEVER commit .env.
# This file lists every env the runtime consults; keep it in sync when a
# new one is introduced.

# --- Database ----------------------------------------------------------
# Postgres DSN for the persistent store (theses, contradictions, proposals,
# llm_calls, abstention_events, rail_health, etc.).
POSTGRES_URL=

# --- Local LLM (Ollama) ------------------------------------------------
# Base URL of the local Ollama daemon and the model tags used for
# primary reasoning + agent-worker calls.
OLLAMA_HOST=
OLLAMA_PRIMARY_MODEL=
OLLAMA_AGENT_MODEL=

# --- Cycle cadence + limits --------------------------------------------
# Minutes between autonomous cycles. 10 today; 2 recommended as SAFE FLOOR
# after cadence-safety audit (Owlracle 100/hr is the tightest limit).
AUTONOMOUS_CYCLE_MINUTES=
# Max cycles per objective before auto-completion. Do NOT change without
# reading MAX_CYCLES semantics — the reclaim path assumes ~5 cycles.
MAX_CYCLES_PER_OBJECTIVE=
# Concurrency limit for spawned worker agents (currently dormant).
MAX_CONCURRENT_AGENTS=

# --- Data-source keys (all optional; absent → SKIP for that source) ----
COINGECKO_API_KEY=
# FRED (St. Louis Fed) — free, needed for macro backtest sources.
FRED_API_KEY=

# --- Self-modification / gates -----------------------------------------
# Shadow verifier delegation. Default OFF — advisory-only shadow.
SHADOW_DELEGATION=
# Auto-approve for Gate 3. Default OFF. Data-criteria guard ALSO required
# even when this is on (see docs/AUTO_APPROVE_DESIGN.md).
AUTO_APPROVE_ENABLED=
# Track-record injection into the generation prompt. Default OFF; no class
# qualifies until eth_gas level reaches n=20 anyway.
TRACK_RECORD_ENABLED=
# Safe runtime fallback ladder (api → claude-cli → ollama). Default ON;
# the ladder is structurally downward-only (upward is impossible
# regardless of this flag). Set to 'off' to disable ALL cross-provider
# fallback and surface the raw provider error to the cycle handler.
LLM_FALLBACK_ENABLED=
# Provider heartbeat interval in minutes. Default 10. Floor 1 minute.
# Transition-only persistence: rows land only when a provider flips
# ok↔down, never every tick.
PROVIDER_HEARTBEAT_MINUTES=
# Orphan-reclaim threshold in minutes. 30 default — enough head-room
# above a legitimate 5-cycle × current-cadence run.
ORPHAN_RECLAIM_MINUTES=

# --- LLM registry (per-task provider override; unset → defaults) -------
# Format: provider[:model] where provider ∈ {ollama, claude-cli, api}.
# All default to ollama:default except REFLECT/SHADOW/SCOUT (claude-cli).
MORGOTH_LLM_THESIS=
MORGOTH_LLM_SYNTHESIS=
MORGOTH_LLM_CHAT=
MORGOTH_LLM_REFLECT=
MORGOTH_LLM_SHADOW=
MORGOTH_LLM_SCOUT=
# Legacy alias for MORGOTH_LLM_THESIS. Still honoured; if BOTH are set,
# MORGOTH_LLM_THESIS wins.
THESIS_GENERATOR=
# Single-source LLM budget in seconds (default 600 = 10 min). Applies to
# claude-cli, anthropic HTTP, and every provider's timeout fallback.
REFLECT_LLM_TIMEOUT_SECONDS=
# Anthropic HTTP-api key. Presence only ever checked; never logged.
ANTHROPIC_API_KEY=

# --- Frontend (Next.js build-time) -------------------------------------
# Chat watchdog upper bound in seconds. Falls back to 600 = the
# REFLECT_LLM_TIMEOUT_SECONDS default. Hard 15-min ceiling in the UI.
NEXT_PUBLIC_LLM_TIMEOUT_SECONDS=

# --- Notifications -----------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Logging / observability -------------------------------------------
# Days of rotated log history to keep (loguru file sink). Default 5.
LOG_RETENTION_DAYS=
# Log level for the loguru root sink.
LOG_LEVEL=

# --- Web / API ---------------------------------------------------------
# App secret key for session / CSRF. Never commit the value.
SECRET_KEY=

# --- Backup / restore (documentation only, not read by runtime) --------
# Restore drill (never tested — run when convenient):
#   1. Backups: /home/corio/Morgoth/backups/*.sql.gz (via scripts/backup_morgoth.sh)
#   2. Scratch DB: createdb morgoth_restore_test
#   3. Restore:  gunzip -c backups/<latest>.sql.gz | psql morgoth_restore_test
#   4. Verify:   psql morgoth_restore_test -c "SELECT COUNT(*) FROM theses;"
#   5. Cleanup:  dropdb morgoth_restore_test
# The drill has NEVER been executed against a real dump. Do it when
# convenient — it's the only way to know the backups are actually usable.
