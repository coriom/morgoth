# Fixture .env for the hermetic test process. Loaded by tests/conftest.py's
# autouse fixture BEFORE any test imports core.config, so load_dotenv sees
# ONLY these values — not the real ~/.env's production Postgres URL or
# claude-cli routing that spawns real subprocesses at 10-40 s each.
POSTGRES_URL=postgresql://test_user:test@127.0.0.1:65535/morgoth_test_do_not_use
OLLAMA_BASE_URL=http://127.0.0.1:65535
OLLAMA_PRIMARY_MODEL=test-model
OLLAMA_AGENT_MODEL=test-model
SECRET_KEY=test-secret
MAX_CONCURRENT_AGENTS=3
LOG_RETENTION_DAYS=1
LOG_LEVEL_THOUGHT=0
# Explicitly UNSET the LLM-router env: hermetic tests must NOT spawn
# `claude` subprocesses.
MORGOTH_LLM_THESIS=
MORGOTH_LLM_SYNTHESIS=
MORGOTH_LLM_CHAT=
